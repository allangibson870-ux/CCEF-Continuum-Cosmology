\section{Protecting emergent Lorentz invariance (new in V4.1)}
\label{sec:protect}

\paragraph{The requirement.} For each species $a$ define $\delta_a(E)\equiv c_a(E)/c-1$. Without protection, radiative corrections give $\delta_a\sim\alpha/\pi\sim10^{-3}$~\cite{Collins2004}. Observations require $|\delta_a-\delta_b|\lesssim10^{-15}$--$10^{-23}$, depending on the species pair~\cite{ColemanGlashow1999,Mattingly2005}. The protecting mechanism must supply 12--20 orders of magnitude of suppression. V4.1 combines two known mechanisms.

\subsection{Mechanism A: attraction to a Lorentz-invariant fixed point}
\st{Established mechanism; Conjecture that CCEF realizes it}

\paragraph{Weak coupling is not enough.} In weakly coupled theories, species velocities do converge at low energies, but only as inverse powers of $\ln(M/E)$~\cite{ChadhaNielsen1983}. Starting from $O(1)$ differences at the grain scale, roughly $10^{-2}$ survives at accessible energies, which fails the bounds by many orders of magnitude.

\paragraph{Strong coupling gives power-law suppression.} Suppose the theory between the grain scale $M=1/\ell$ and a lower scale $\Lambda_*$ is strongly coupled and flows toward a Lorentz-invariant fixed point. If the leading Lorentz-violating operator there has scaling dimension $4+\gamma$ with $\gamma>0$, then~\cite{BPS2013}
\begin{equation}
\delta_a(E)\simeq C_a\Big(\frac{E}{M}\Big)^{\gamma}\quad(E\gtrsim\Lambda_*),
\qquad
\delta_a\simeq C_a\Big(\frac{\Lambda_*}{M}\Big)^{\gamma}\quad(E\lesssim\Lambda_*).
\label{eq:powerlaw}
\end{equation}

\paragraph{Why one $c$ in CCEF.} \st{Conjecture} Every CCEF species is an excitation of the same grain network, so all of them emerge from one strongly coupled sector and flow toward the same fixed point. A single limiting speed is then a consequence of a shared origin rather than an accident. This is the universality that makes critical phenomena insensitive to lattice details, the same idea invoked for $n_s$ in Section~\ref{sec:cosmo}.

\paragraph{Quantitative requirement.} With $C_a\sim1$ and $M=1.77\times10^{19}$\,GeV:

\begin{center}
\begin{tabular}{ll}
\toprule
Condition & Requirement \\
\midrule
$|\delta|<10^{-23}$ at $E\sim1$\,GeV & $\gamma>1.2$ \\
$|\delta|<10^{-23}$ at $E\sim10^{11}$\,GeV (cosmic rays) & $\gamma>2.8$ \\
Residual below $\Lambda_*$ under $10^{-23}$ & $\Lambda_*<M\cdot10^{-23/\gamma}$: $5.6\times10^{7}$\,GeV ($\gamma=2$), $3.8\times10^{11}$\,GeV ($\gamma=3$) \\
\bottomrule
\end{tabular}
\end{center}

\noindent The conservative requirement is $\gamma\gtrsim3$.

\subsection{Mechanism B: emergent supersymmetry}
\st{Established mechanism; Conjecture that CCEF realizes it}

Supersymmetry forbids Lorentz-violating operators of dimension $\le4$~\cite{NibbelinkPospelov2005}. CPT, already imposed in Section~\ref{sec:lorentz}, removes the dimension-5 operators. If supersymmetry is softly broken at a scale $m_s$, dimension-4 Lorentz violation is regenerated only at
\begin{equation}
\delta\sim\Big(\frac{m_s}{M}\Big)^2\approx3\times10^{-31}\quad\text{for } m_s=10\ \text{TeV}.
\end{equation}
Requiring $\delta<10^{-23}$ gives $m_s\lesssim5.6\times10^{7}$\,GeV.

\st{Established} Spacetime supersymmetry can \emph{emerge} at critical points and boundaries of lattice models built from non-supersymmetric degrees of freedom~\cite{Lee2007,GSV2014}. \st{Conjecture} CCEF's geometric phase has an emergent supersymmetric window between $M$ and $m_s$.

\paragraph{Prediction.} If Mechanism B is required, superpartners exist between the current collider limits (around the TeV scale) and about $6\times10^{7}$\,GeV.

\subsection{Combined picture}
\begin{enumerate}[leftmargin=*]
\item $E\sim1/\ell\approx1.8\times10^{19}$\,GeV: individual grains. Lattice Lorentz violation is $O(1)$.
\item $M>E>\Lambda_*$: the network is strongly coupled. Lorentz violation decays as $(E/M)^\gamma$ (Mechanism A).
\item Emergent supersymmetric window down to $m_s$. Dimension-4 Lorentz violation is forbidden (Mechanism B).
\item Below $m_s$: weakly coupled, Standard-Model-like physics, with residual $|\delta|\lesssim\max\big[(\Lambda_*/M)^\gamma,(m_s/M)^2\big]\ll10^{-23}$.
\end{enumerate}

\noindent Mechanism A supplies most of the suppression. Mechanism B prevents Lorentz violation from being regenerated once weak coupling takes over. Either alone may suffice in parts of parameter space; together they make the bound robust.

\subsection{Alternatives not adopted}
\begin{itemize}[leftmargin=*]
\item \textbf{Sequestering}~\cite{PospelovShang2012}. Lorentz violation is confined to the gravitational sector and reaches matter only through gravity, suppressed by $(E/\Mpl)^2$. This is unnatural in CCEF, where matter is made of the same grains.
\item \textbf{Random grains}~\cite{BHS2009}. If grains are Poisson-distributed spacetime events, as in causal sets, there is no preferred frame and nothing to protect. This would require rebuilding relational time (Section~\ref{sec:dynamics}) around causal order. It would make emergent photons and fermions harder, and it would remove the hidden-frame interpretation. It is compatible with the grain-number randomness of Section~\ref{sec:lambda}. \textbf{This is the fallback if Mechanisms A and B fail.}
\end{itemize}

\subsection{Observable consequences}
\begin{itemize}[leftmargin=*]
\item Any detected Lorentz violation should grow with energy as $E^\gamma$, with one common $\gamma$ across probes, and should be universal across species at low energy.
\item The V4 statement that an $O(1)$ quadratic ($\gamma=2$) term is a prediction is withdrawn. Present data should show no Lorentz violation.
\item Superpartners lie in the window above, if Mechanism B is needed.
\end{itemize}

